# ASPIRE server configuration. Copy these into your host's environment.
# Never commit a real .env file.

# Signs login tokens. Set a long random value in production (the Render blueprint generates one).
ASPIRE_SECRET=

# Optional shared code required at login. Leave empty to disable.
ASPIRE_ACCESS_CODE=

# School contact number for About and the parent "Contact School" button.
# Leave empty to hide the button and show "Contact the school office".
ASPIRE_SCHOOL_PHONE=(049) 508-4412

# Deprecated: the Super Admin role was merged into the Principal. These are still
# read for compatibility and bootstrap a Principal, but use ASPIRE_PRINCIPAL_*.
ASPIRE_SUPER_ADMIN_EMAIL=
ASPIRE_SUPER_ADMIN_PASSWORD=

# Principal login used to register teacher accounts.
# Use a real admin account for production; default values are intentionally safe but should be changed.
ASPIRE_PRINCIPAL_EMAIL=principal@gmail.com
ASPIRE_PRINCIPAL_PASSWORD=SchoolLead!2026444

# One-time credential recovery: set to 1, restart, sign in with the
# ASPIRE_PRINCIPAL_* values above, then set it back to 0 (while set it re-applies
# on every boot). It also clears any lockout and signs out other devices.
ASPIRE_RESET_PRINCIPAL=0

# Set to 1 in production to require teacher accounts to use a real Gmail address.
ASPIRE_REQUIRE_GMAIL=0

# PostgreSQL connection string (optional). When set, Postgres is the ONLY store:
# the JSON file is ignored. Leave blank for local dev, where ./data/aspire-db.json
# is used instead.
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}  (private *.railway.internal URL)
# Render:  set by the blueprint from the managed database.
DATABASE_URL=

# TLS for the database connection. Left unset, private/internal and localhost
# hosts connect without TLS and public proxies (*.proxy.rlwy.net, *.render.com)
# use TLS. Set to disable or require to override the guess.
PGSSLMODE=

# Where aspire-db.json lives. Defaults to ./data. Ignored when DATABASE_URL is set.
DATA_DIR=

# Demo endpoints / data. All off unless explicitly enabled.
# NOTE: /api/admin/reset is additionally refused whenever NODE_ENV=production.
ALLOW_DEMO_RESET=0
SEED_DEMO_INCIDENT=0
SEED_DEMO_ACCOUNTS=0

# Retention — PLACEHOLDER periods, to be set by the school's data protection contact.
# Positive whole numbers of days. Invalid values fall back to the default and log a warning.
# Days after which a closed ticket is moved to the archive (sweep on start + hourly).
ASPIRE_ARCHIVE_AFTER_DAYS=7
# Days a purge may erase personal data after an ACCOUNT was archived.
ASPIRE_RETENTION_ACCOUNTS_DAYS=365
# Days a purge may anonymise a TICKET after it was archived.
ASPIRE_RETENTION_INCIDENTS_DAYS=730
# Days a stored drill summary is kept.
ASPIRE_RETENTION_DRILLS_DAYS=180
# Days a notification log would be kept — currently skipped: no persistent store.
ASPIRE_RETENTION_NOTIFICATIONS_DAYS=90

# ---------------------------------------------------------------- email ------
# console (default in development/tests; prints to the server log and never
# active in production), smtp (nodemailer), or resend (HTTPS API).
# If this is left blank, the app auto-detects valid SMTP/Resend settings.
MAIL_DRIVER=
# Required for smtp/resend. Example: ASPIRE <no-reply@your-school.example>
MAIL_FROM=ASPIRE <no-reply@your-school.example>
# Public app URL used for invitation links. No trailing slash required.
APP_BASE_URL=http://localhost:5173

# SMTP (works for Gmail and most hosted providers; use an app password for Gmail).
# Gmail needs no separate API key: the address plus its 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) is enough.
# Paste real values without quotes or angle brackets – placeholder text keeps mail
# off, and GET /api/health then reports why in mail.problem.
# Example Gmail values:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=yourgmailaccount@gmail.com
# SMTP_PASS=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=

# Resend HTTPS API (no SDK; works when SMTP ports are blocked).
RESEND_API_KEY=
